<UserControl x:Class="EliteInfoPanel.Controls.HyperspaceOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EliteInfoPanel.Controls"
             mc:Ignorable="d">
    <UserControl.Resources>
        <DropShadowEffect x:Key="ShadowEffect"
                      Color="#80000000"
                      BlurRadius="20"
                      ShadowDepth="0"
                      Opacity="0.6" />
    </UserControl.Resources>

    <Grid x:Name="RootGrid"
          Background="Black"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          Visibility="Collapsed">

        <!-- Video background with centered cropping -->
        <MediaElement x:Name="JumpVideoPlayer"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Stop"
                      Stretch="UniformToFill"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      MediaEnded="JumpVideoPlayer_MediaEnded"
                      MediaOpened="JumpVideoPlayer_MediaOpened"
                      MediaFailed="JumpVideoPlayer_MediaFailed"
                      Volume="0" />

        <!-- Central content with text information -->
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Vertical"
                    Margin="20">
            <!-- Elite-style container for text -->
            <Border Background="#AA000000" 
                CornerRadius="12"
        Padding="30,20"
        BorderThickness="1"
        BorderBrush="#30FFFFFF"
        Effect="{DynamicResource ShadowEffect}">
                <StackPanel>
                    <!-- Jump destination text -->
                    <TextBlock x:Name="JumpDestinationText"
                   Text="Hyperspace Jump in Progress..."
                   Foreground="#FFFFFF"
                   FontSize="48"
                   FontWeight="Light"
                   TextAlignment="Center"
                   Margin="0,0,0,20" />

                    <!-- Star class info -->
                    <TextBlock x:Name="StarClassText"
                   Text="Star Class: Unknown"
                   Foreground="#FFFFFF"
                   FontSize="28"
                   FontWeight="Light"
                   TextAlignment="Center"
                   Margin="0,0,0,20" />

                    <!-- Legal status info -->
                    <TextBlock x:Name="LegalStateText"
                   Text="Legal Status: Clean"
                   Foreground="#A0FFFFFF"
                   FontSize="24"
                   FontWeight="Light"
                   TextAlignment="Center"
                   Margin="0,0,0,30" />

                    <!-- Animated progress bar -->
                    <ProgressBar x:Name="JumpProgressBar"
                     Height="10"
                     Width="400"
                     IsIndeterminate="True"
                     Foreground="#80FFFFFF"
                     Background="#20FFFFFF" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>